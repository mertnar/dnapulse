{
  "name": "dna-categorization",
  "version": "1.0.0",
  "description": "DNA Platform Categorization Microservice - Labels processed items using pluggable labelers",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t dna-categorization .",
    "docker:run": "docker run -p 8083:8083 dna-categorization"
  },
  "keywords": [
    "categorization",
    "microservice",
    "labeling",
    "dna-platform",
    "typescript",
    "fastify"
  ],
  "author": "DNA Platform Team",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/jwt": "^7.2.4",
    "@opentelemetry/auto-instrumentations-node": "^0.40.0",
    "@opentelemetry/exporter-jaeger": "^1.18.1",
    "@opentelemetry/resources": "^1.18.1",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/semantic-conventions": "^1.18.1",
    "ajv": "^8.12.0",
    "axios": "^1.12.2",
    "eventsource": "^2.0.2",
    "expr-eval": "^2.0.2",
    "fastify": "^4.24.3",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.3.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "prom-client": "^15.0.0",
    "tsx": "^4.6.2"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.12",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dna-platform/categorization"
  },
  "bugs": {
    "url": "https://github.com/dna-platform/categorization/issues"
  },
  "homepage": "https://github.com/dna-platform/categorization#readme"
}
