{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Processing Rules Configuration",
  "description": "Schema for processing service configuration rules",
  "type": "object",
  "properties": {
    "normalization": {
      "type": "object",
      "description": "Normalization rules",
      "properties": {
        "timestamp": {
          "type": "string",
          "enum": ["rfc3339"],
          "description": "Timestamp format"
        },
        "drop_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields to drop from events"
        }
      }
    },
    "enrichment": {
      "type": "object",
      "description": "Enrichment rules",
      "properties": {
        "lookup_tables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": "Lookup tables for value mapping"
        },
        "add_attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Static attributes to add to events"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Configuration metadata",
      "properties": {
        "version": {
          "type": "string",
          "description": "Configuration version"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "updated_by": {
          "type": "string",
          "description": "User who last updated the configuration"
        }
      }
    }
  },
  "required": [],
  "additionalProperties": true
}
