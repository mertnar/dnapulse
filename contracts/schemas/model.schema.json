{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Model Configuration Schema",
  "description": "Schema for model service configuration",
  "properties": {
    "active_model": {
      "type": "string",
      "description": "Name of the active model"
    },
    "version": {
      "type": "string",
      "description": "Model version"
    },
    "params": {
      "type": "object",
      "properties": {
        "label_required": {
          "type": "string",
          "description": "Required label for anomaly detection"
        },
        "count_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum count threshold for anomaly detection"
        },
        "score_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Score threshold for anomaly detection"
        },
        "emit_normal": {
          "type": "boolean",
          "description": "Whether to emit normal (non-anomaly) inferences"
        }
      },
      "required": ["label_required", "count_threshold", "score_threshold", "emit_normal"],
      "additionalProperties": false
    }
  },
  "required": ["active_model", "version", "params"],
  "additionalProperties": false
}
